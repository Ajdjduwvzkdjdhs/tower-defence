diff --git a/core/serial/impl/unix/list_ports_osx.cpp b/core/serial/impl/unix/list_ports_osx.cpp
new file mode 100644
index 0000000..a791b44
--- /dev/null
+++ b/core/serial/impl/unix/list_ports_osx.cpp
@@ -0,0 +1,62 @@
+#if defined(__APPLE__)
+
+/*
+ * macOS 版の list_ports()。
+ * 本家 SDK には Linux 版（list_ports_linux.cpp）と Windows 版しかなく、
+ * macOS では ydlidar::core::serial::list_ports() が未定義のままリンクに失敗する。
+ * IOKit を引っ張らずに済むよう、/dev のデバイスファイルを glob で拾うだけの
+ * 最小実装にしてある（USB シリアル変換の port 一覧が得られれば十分）。
+ */
+
+#include <glob.h>
+
+#include <string>
+#include <vector>
+
+#include <core/serial/serial.h>
+
+namespace ydlidar {
+namespace core {
+namespace serial {
+
+std::vector<PortInfo> list_ports()
+{
+  static const char *kPatterns[] = {
+    "/dev/tty.usb*",     // CP210x / FTDI / CDC など一般的な USB シリアル
+    "/dev/cu.usb*",
+    "/dev/tty.SLAB*",    // Silicon Labs の古いドライバ
+    "/dev/tty.wchusb*",  // WCH CH34x
+  };
+
+  std::vector<PortInfo> results;
+
+  glob_t paths;
+  int flags = GLOB_NOSORT;
+
+  for (size_t i = 0; i < sizeof(kPatterns) / sizeof(kPatterns[0]); ++i) {
+    glob(kPatterns[i], flags, NULL, &paths);
+    flags |= GLOB_APPEND;  // 2 回目以降は結果を追記していく
+  }
+
+  for (size_t i = 0; i < paths.gl_pathc; ++i) {
+    std::string device(paths.gl_pathv[i]);
+    std::string name = device.substr(device.find_last_of('/') + 1);
+
+    PortInfo entry;
+    entry.port = device;
+    entry.description = name;
+    entry.hardware_id = "n/a";  // IOKit を使わないので VID:PID は取れない
+    entry.device_id = name;
+    results.push_back(entry);
+  }
+
+  globfree(&paths);
+
+  return results;
+}
+
+}  // namespace serial
+}  // namespace core
+}  // namespace ydlidar
+
+#endif  // defined(__APPLE__)
