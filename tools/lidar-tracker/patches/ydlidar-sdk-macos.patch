 ############################################################################
 # find package
 find_package(SWIG)
-find_package(PythonInterp)
-find_package(PythonLibs)
+# FindPythonInterp / FindPythonLibs は非推奨で、setup.py が渡した
+# PYTHON_EXECUTABLE を無視してシステム側の別バージョンの libpython を拾う。
+# （3.13 の Framework をリンクした .so を 3.14 で import すると
