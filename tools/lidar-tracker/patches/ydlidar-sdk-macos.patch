 #############################################################################
 # option
 option( BUILD_SHARED_LIBS "Build shared libraries." OFF)
-option( BUILD_EXAMPLES "Build Example." ON)
+option( BUILD_EXAMPLES "Build Example." OFF) # C++ サンプルは librt を要求し macOS でリンクできない
 option( BUILD_CSHARP "Build CSharp." OFF)
