# uv virtual env（Assets/ 外なので Unity は無視。環境はこのフォルダに自閉）
.venv/
__pycache__/

# 実行時に生成される共有ファイル（Unity が読む出力）。コミットしない。
out/

# 実機ごとのシリアルポート設定。テンプレは config.example.toml をコミット。
config.toml

# 内覧会（連続座標）モードの現物設定。テンプレは preview.example.toml をコミット。
preview.toml

# 公式 SDK の clone（setup-sdk.sh が作る）。パッチだけコミットする
vendor/
